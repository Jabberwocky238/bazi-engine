{
  "name": "@jabberwocky238/bazi-engine",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "shishen": "bun run test/cli-shishen.ts",
    "shensha": "bun run test/cli-shensha.ts",
    "ganzhi": "bun run test/cli-ganzhi.ts",
    "clean": "rm -rf dist",
    "build": "mkdir -p dist && bun build ./src/index.ts --outdir dist --target bun && bunx tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "lunar-typescript": "^1.8.6"
  }
}
